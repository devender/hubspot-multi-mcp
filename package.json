{
  "name": "hubspot-multi-mcp",
  "version": "0.1.0",
  "description": "Local, read-only MCP server that connects Claude to MANY HubSpot portals at once, by name. Unofficial, not affiliated with HubSpot.",
  "type": "module",
  "bin": {
    "hubspot-multi-mcp": "cli.js"
  },
  "scripts": {
    "setup": "node cli.js setup",
    "verify": "node cli.js verify",
    "start": "node cli.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "cli.js",
    "server.js",
    "setup.js",
    "verify.js",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hubspot",
    "claude",
    "crm",
    "multi-account",
    "multi-portal"
  ],
  "license": "MIT",
  "author": "Devender Gollapally",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devender/hubspot-multi-mcp.git"
  },
  "homepage": "https://github.com/devender/hubspot-multi-mcp#readme",
  "bugs": {
    "url": "https://github.com/devender/hubspot-multi-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
